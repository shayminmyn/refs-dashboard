PORT=4000

# MongoDB Atlas (Cloud) — tạo cluster tại https://cloud.mongodb.com → Database → Connect → Drivers
# Thay USER, PASS, cluster host và tên DB; PASS nên URL-encode nếu có ký tự đặc biệt (@ → %40)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/refs_dashboard?retryWrites=true&w=majority

# Mongo local (Docker profile local-mongo hoặc mongodb://localhost:27017/refs_dashboard)
# MONGODB_URI=mongodb://mongo:27017/refs_dashboard
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_DAYS=7
FRONTEND_URL=http://localhost:3000

# BingX Partner API
BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_BASE_URL=https://open-api.bingx.com

# Exness Partner API (dùng email + password của Partner Area tại my.exnessaffiliates.com)
EXNESS_LOGIN=your_partner_email@example.com
EXNESS_PASSWORD=your_partner_password
EXNESS_BASE_URL=https://my.exnessaffiliates.com

# Bitget Affiliate API
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_BASE_URL=https://api.bitget.com
